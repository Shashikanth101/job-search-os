DATABASE_PATH=./data/jobs.db
CAREER_PAGES_JSON=[]

# LLM Configuration — swap provider without touching code
LLM_PROVIDER=anthropic         # anthropic | openai | groq | ollama
LLM_API_KEY=your_api_key_here  # not needed for ollama
LLM_MODEL=                     # optional — uses provider default if empty

# Firecrawl
FIRECRAWL_API_KEY=your_key_here

# Server
PORT=3001