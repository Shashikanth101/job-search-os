# Canonical list of every environment variable the app reads (src/ and scripts/).
# Copy to .env (never commit .env). `npm run env:check` compares the two; `npm run env:sync` appends missing keys.

# SQLite database file.
DATABASE_PATH=./data/jobs.db
# Express API port.
PORT=3001
# Runtime mode (tests set this to "test", which disables real LLM calls).
NODE_ENV=development
# Extra Firecrawl career pages as a JSON array of {url, company, source}.
CAREER_PAGES_JSON=[]
# Firecrawl API key (needed for the Swiggy scraper and CAREER_PAGES_JSON pages).
FIRECRAWL_API_KEY=your-key-here

# Ranker LLM provider: anthropic (native Messages API) | openai | groq | ollama.
LLM_PROVIDER=anthropic
# Ranker LLM API key (not needed for ollama, or when LLM_DISABLED=1).
LLM_API_KEY=your-key-here
# Ranker model id; empty uses the provider default (e.g. claude-haiku-5-5).
LLM_MODEL=
# Ollama base URL override (Ollama only); empty uses http://localhost:11434/v1.
LLM_BASE_URL=
# Set to 1 to disable all LLM calls (kill switch).
LLM_DISABLED=
# Per-request LLM timeout in milliseconds.
LLM_TIMEOUT_MS=60000
# Set to 1 only after verifying thinking:{type:"disabled"} works for your Anthropic model.
LLM_ANTHROPIC_DISABLE_THINKING=
# Daily LLM spend cap in USD, summed from the llm_usage ledger.
LLM_DAILY_BUDGET_USD=0.50

# Resume LLM provider; empty falls back to LLM_PROVIDER.
RESUME_LLM_PROVIDER=
# Resume LLM API key; empty or placeholder falls back to LLM_API_KEY.
RESUME_LLM_API_KEY=your-key-here
# Resume model id; empty falls back to LLM_MODEL.
RESUME_LLM_MODEL=
# Resume Ollama base URL (requires RESUME_LLM_PROVIDER=ollama).
RESUME_LLM_BASE_URL=

# Maximum jobs ranked per run.
RANK_MAX_JOBS_PER_RUN=200
# Parallel ranking requests (bounded worker pool).
RANK_CONCURRENCY=4
# Attempts for a job whose model output was unusable before it stops retrying.
RANK_MAX_ATTEMPTS=3
# Backoff base in minutes for failed ranking retries (multiplied by 4 per attempt).
RANK_RETRY_BASE_MINUTES=60
# Output token cap per ranking call; a response truncated at the cap is a retryable failure.
RANK_MAX_TOKENS=600
