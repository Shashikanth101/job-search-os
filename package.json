{
  "name": "job-search-os",
  "version": "1.0.0",
  "private": true,
  "description": "Personal job search automation backend",
  "type": "module",
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "start": "node src/server.js",
    "frontend": "cd frontend && npm install && npm run dev",
    "dev": "concurrently 'node src/server.js' 'cd frontend && npm run dev'",
    "scrape": "node src/scrape.js",
    "rerank": "node src/scripts/rerank.js",
    "generate-resume": "node src/scripts/generate-resume.js"
  },
  "dependencies": {
    "@mendable/firecrawl-js": "^1.29.0",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.9"
  }
}
